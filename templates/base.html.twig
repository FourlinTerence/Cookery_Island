<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Cookery Island{% endblock %}</title>

        {# Polices officielles définies par la charte graphique : Calistoga (H1), Copse (H2/H3), Montserrat (Corps) #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Calistoga&family=Copse&family=Montserrat:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

        <link rel="icon" href="{{ asset('images/Logo.Cookery_Island.png') }}">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="site-body">
        {# Bloc d'en-tête personnalisable (peut être omis sur les pages de connexion/inscription) #}
        {% block header %}
        <header class="site-header">
            <div class="header-container">
                <a href="/" class="header-logo-link" title="Cookery Island - Accueil">
                    <img src="{{ asset('images/Logo.Cookery_Island.png') }}" alt="Logo Cookery Island" class="header-logo">
                </a>

                <nav class="header-nav" aria-label="Navigation principale">
                    {# Éléments non encore fonctionnels grisés conformément à la règle stricte de l'interface #}
                    <span class="nav-item nav-item-disabled" aria-disabled="true" title="Fonctionnalité en cours de développement">Nos recettes</span>
                    <span class="nav-item nav-item-disabled" aria-disabled="true" title="Fonctionnalité en cours de développement">Cours de cuisine</span>
                    <a href="{{ path('app_login') }}" class="nav-item nav-item-active" aria-current="page">Connexion</a>
                </nav>

                <div class="header-profile" title="Espace utilisateur">
                    <img src="{{ asset('images/profil.png') }}" alt="Icône profil utilisateur" class="header-profile-icon">
                </div>
            </div>
        </header>
        {% endblock %}

        {# Contenu principal spécifique à chaque page #}
        <main class="page-main-wrapper">
            {% block body %}{% endblock %}
        </main>

        {# Pied de page reprenant fidèlement le template article #}
        <footer class="site-footer">
            <div class="footer-container">
                <div class="footer-logo-box">
                    <img src="{{ asset('images/Logo.Cookery_Island.png') }}" alt="Logo Cookery Island" class="footer-logo">
                </div>
                <p class="footer-copyright">©Cookery_Island corporation. Tous droits réservés.</p>
            </div>
        </footer>
    </body>
</html>
