<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Cookery Island - Blog culinaire & Recettes{% endblock %}</title>

        {# Polices officielles définies par la charte graphique : Calistoga (H1), Copse (H2/H3), Montserrat (Corps) #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Calistoga&family=Copse&family=Montserrat:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

        <link rel="icon" type="image/png" href="{{ asset('images/Logo.Cookery_Island.png') }}">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# =====================================================================
           BLOC HEADER (EN-TÊTE & NAVIGATION)
           Définit la barre de navigation du site via un partial réutilisable.
           Ce bloc peut être surchargé ou désactivé par les templates enfants
           (ex: pages de connexion et d'inscription qui masquent la barre).
           ===================================================================== #}
        {% block header %}
            {% include 'partials/_header.html.twig' %}
        {% endblock %}

        {# =====================================================================
           BLOC MAIN / BODY (CONTENU PRINCIPAL)
           Zone centrale dynamique spécifique à chaque vue de l'application.
           ===================================================================== #}
        <main>
            {% block body %}{% endblock %}
        </main>

        {# =====================================================================
           BLOC FOOTER (PIED DE PAGE)
           Affiche les informations de marque, menus de navigation et copyright.
           Ce bloc peut être personnalisé ou masqué selon les besoins des pages.
           ===================================================================== #}
        {% block footer %}
            {% include 'partials/_footer.html.twig' %}
        {% endblock %}
    </body>
</html>
