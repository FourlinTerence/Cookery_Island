{# =============================================================================
   PARTIAL: HEADER & NAVIGATION
   Comprend le logo du site, les liens de navigation et la zone d'authentification.
   Inclus par défaut dans le bloc {% block header %} du layout base.html.twig.
   ============================================================================= #}
<header>
    <nav class="navbar">
        <div class="navbar-container">
            {# Marque du site avec logo agrandi et nom #}
            <a href="{{ path('app_home') }}" class="navbar-brand">
                <img src="{{ asset('images/Logo.Cookery_Island.png') }}" alt="Cookery Island Logo" class="navbar-logo">
                <span class="navbar-title">Cookery Island</span>
            </a>

            {# Liens de navigation principaux #}
            <ul class="navbar-nav">
                <li><a href="{{ path('app_home') }}" class="nav-link active">Accueil</a></li>
                <li><a href="#recettes" class="nav-link">Nos Recettes</a></li>
                <li><a href="#presentation" class="nav-link">L'Île Culinaire</a></li>
            </ul>

            {# Zone d'authentification utilisateur / Boutons d'action #}
            <div class="navbar-auth">
                {% if app.user %}
                    <span class="nav-user">Bonjour, <strong>{{ app.user.username ?? app.user.userIdentifier }}</strong></span>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="#" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.4rem 0.9rem;">Dashboard</a>
                    {% endif %}
                    <a href="#" class="btn btn-accent">+ Publier</a>
                {% else %}
                    <a href="#" class="btn btn-outline">Connexion</a>
                    <a href="#" class="btn btn-primary">Inscription</a>
                {% endif %}
            </div>
        </div>
    </nav>
</header>
