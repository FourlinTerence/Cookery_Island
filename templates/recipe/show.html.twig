{% extends 'base.html.twig' %}

{% block title %}{{ recipe.title }} - Cookery Island{% endblock %}

{% block body %}
    {# =========================================================================
       1. HERO BANNER DE LA RECETTE
       Bannière avec fond d'ustensiles et titre de la recette en vedette
       ========================================================================= #}
    <section class="hero-banner recipe-hero">
        <div class="hero-content">
            <h1 class="hero-title">{{ recipe.title }}</h1>
            <p class="hero-subtitle">{{ recipe.category }} • {{ recipe.difficulty }} • {{ recipe.totalTime }} min au total</p>
        </div>
    </section>

    <div class="main-content recipe-content">
        {# =====================================================================
           2. IMAGE PRINCIPALE DE LA RECETTE
           Grande photo mise en avant du plat préparé
           ===================================================================== #}
        <div class="recipe-main-media">
            <img src="{{ asset('images/' ~ recipe.image) }}" alt="{{ recipe.title }}" class="recipe-featured-img">
        </div>

        {# =====================================================================
           3. FICHE RÉSUMÉE DES CARACTÉRISTIQUES (MÉTADONNÉES)
           Temps de préparation, cuisson, portions et difficulté
           ===================================================================== #}
        <div class="recipe-meta-cards">
            <div class="recipe-meta-box">
                <span class="meta-box-icon">⏱️</span>
                <span class="meta-box-label">Préparation</span>
                <span class="meta-box-value">{{ recipe.prepTime }} min</span>
            </div>
            <div class="recipe-meta-box">
                <span class="meta-box-icon">🔥</span>
                <span class="meta-box-label">Cuisson</span>
                <span class="meta-box-value">{{ recipe.cookTime }} min</span>
            </div>
            <div class="recipe-meta-box">
                <span class="meta-box-icon">👥</span>
                <span class="meta-box-label">Portions</span>
                <span class="meta-box-value">{{ recipe.servings }} personnes</span>
            </div>
            <div class="recipe-meta-box">
                <span class="meta-box-icon">⭐</span>
                <span class="meta-box-label">Difficulté</span>
                <span class="meta-box-value">{{ recipe.difficulty }}</span>
            </div>
        </div>

        {# =====================================================================
           4. BLOC DES INGRÉDIENTS (DISPOSITION SUR 2 COLONNES)
           Conforme à la maquette : 2 colonnes à puces sur fond sablé doux
           ===================================================================== #}
        <section class="recipe-card-box recipe-ingredients-box">
            <h2 class="recipe-box-title">Ingrédients</h2>
            <div class="ingredients-grid">
                <ul class="ingredients-list">
                    {% for item in recipe.ingredients.col1 %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
                <ul class="ingredients-list">
                    {% for item in recipe.ingredients.col2 %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        {# =====================================================================
           5. ÉTAPE 1 DE PRÉPARATION
           Explications détaillées de la première phase de cuisine
           ===================================================================== #}
        <section class="recipe-card-box recipe-step-box">
            <h3 class="recipe-step-title">{{ recipe.steps[0].title }}</h3>
            <p class="recipe-step-text">{{ recipe.steps[0].content }}</p>
        </section>

        {# =====================================================================
           6. IMAGE INTERMÉDIAIRE ILLUSTRATIVE
           Photo d'illustration intermédiaire conforme à la maquette de l'article
           ===================================================================== #}
        <div class="recipe-secondary-media">
            <img src="{{ asset('images/' ~ recipe.secondaryImage) }}" alt="Mijotage et cuisson des saveurs créoles" class="recipe-step-img">
        </div>

        {# =====================================================================
           7. ÉTAPE 2 DE PRÉPARATION
           Explications de la phase de mijotage et conseils de dégustation
           ===================================================================== #}
        <section class="recipe-card-box recipe-step-box">
            <h3 class="recipe-step-title">{{ recipe.steps[1].title }}</h3>
            <p class="recipe-step-text">{{ recipe.steps[1].content }}</p>
        </section>

        {# =====================================================================
           8. ESPACE COMMENTAIRES
           Liste des avis communautaires et formulaire d'ajout d'un commentaire
           ===================================================================== #}
        <section class="recipe-card-box recipe-comments-box">
            <h2 class="comments-main-title">Commentaires ({{ recipe.comments|length }})</h2>

            {# Liste des commentaires existants #}
            <div class="comments-list">
                {% for comment in recipe.comments %}
                    <article class="comment-item">
                        <div class="comment-header">
                            <span class="comment-avatar">{{ comment.avatar }}</span>
                            <div class="comment-user-info">
                                <strong class="comment-author">{{ comment.author }}</strong>
                                <span class="comment-date">{{ comment.date }}</span>
                            </div>
                            <div class="comment-rating" aria-label="Note 5 sur 5">
                                {% for i in 1..comment.rating %}
                                    <span class="star-icon">⭐</span>
                                {% endfor %}
                            </div>
                        </div>
                        <p class="comment-content">{{ comment.content }}</p>
                    </article>
                {% endfor %}
            </div>

            {# Formulaire fictif d'ajout de commentaire #}
            <div class="comment-form-wrapper">
                <h3 class="comment-form-title">Postez votre commentaire</h3>
                <form action="#" method="post" class="comment-form" onsubmit="event.preventDefault(); alert('Merci pour votre commentaire ! Il sera publié prochainement.');">
                    <div class="form-group">
                        <label for="comment-pseudo">Votre pseudo</label>
                        <input type="text" id="comment-pseudo" name="pseudo" placeholder="Ex: ChefGourmet974" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="comment-message">Votre message</label>
                        <textarea id="comment-message" name="message" rows="4" placeholder="Partagez votre avis, vos astuces ou vos variantes sur cette recette..." required class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-accent">Publier mon commentaire</button>
                </form>
            </div>
        </section>
    </div>
{% endblock %}
